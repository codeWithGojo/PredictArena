# API-Football / API-Sports key used for football fixtures.
# Create a key at https://dashboard.api-football.com and add the same variable in Vercel.
API_FOOTBALL_KEY=

# football-data.org token for Serie A, Bundesliga, Ligue 1, and Champions League.
# Keep this server-side only. Set in Vercel Production environment variables.
FOOTBALL_DATA_TOKEN=

# Legacy provider used only for non-football feeds until basketball/tennis are migrated.
THE_SPORTS_DB_API_KEY=123

# Optional canonical URL override. Vercel supplies its production URL automatically.
NEXT_PUBLIC_SITE_URL=

# Dedicated PredictArena Supabase Auth project. Publishable key is safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
